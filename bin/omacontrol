#!/bin/bash
# omacontrol — the state reader and mutator behind the OmaControl window.
#
# The window stays declarative: it asks for `state` as one JSON document and
# calls a subcommand for every change. Everything that shells out lives in
# lib/, one module per thing being configured:
#
#   core.sh          paths, file writing, first-touch backups
#   i18n.sh          the language of every sentence this backend prints
#   language.sh      the session language Omarchy runs in
#   store.sh         OmaControl' own store of what it has set
#   hypr.sh          Hyprland options, live and in a generated config
#   devices.sh       per-device input settings (Hyprland's hl.device)
#   monitors.sh      displays: resolution and scale, per screen (keyed by the
#                    display's own description, not the connector it is in)
#   shell_config.sh  ~/.config/omarchy/shell.json
#   compose.sh       ~/.XCompose
#   plugins.sh       installed shell plugins
#   menu.sh          the Omarchy menu definition: groups, actions, icon fonts
#   herdr.sh         ~/.config/herdr/config.toml
#   tmux.sh          ~/.config/tmux/tmux.conf
#   neovim.sh        ~/.config/nvim/lua/config/options.lua
#   bindings.sh      Hyprland keybindings
#   wifi.sh          NetworkManager
#   bluetooth.sh     BlueZ, through Omarchy's power and device wrappers
#   power.sh         battery reading and the per-source power profile
#   disk.sh          what the disks hold, and their health
#   processes.sh     what the machine is busy with
#   overview.sh      the switches and notices on the Overview page
#   migrate.sh       bringing an OmaSettings install across
#   packages.sh      what pacman has, and what it is waiting to do
#   security.sh      what can reach this machine, and how you sign in to it
#   hosts.sh         /etc/hosts, read; edited only in the reader's own editor
#   usage.sh         what the coding agent has been spending
#   news.sh          headlines from omarchy.org — the one outbound request
#   apps.sh          every application, and what this desktop does with it
#   about.sh         what this machine is
#   branding.sh      the ASCII the screensaver and About screen draw
#   audio.sh         outputs, inputs, volume and mute
#   setters.sh       the `set` subcommand's routing
#   state.sh         one JSON document assembled from all of the above

set -uo pipefail

OMACONTROL_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# A detached update re-enters here, so this script has to be able to name
# itself: it is started from the window's own copy, which is not on any PATH.
OMACONTROL_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

for module in core i18n language store hypr devices monitors workspaces shell_config compose plugins menu herdr tmux neovim bindings themes wifi bluetooth power audio disk processes packages security hosts apps usage news about branding overview migrate setters state; do
  # shellcheck source=/dev/null
  source "$OMACONTROL_LIB/$module.sh"
done
unset module

# Whatever a subcommand prints is retained and parsed by a shell that lives as
# long as the bar does, so the last word on how much of it can arrive belongs
# here rather than to any one producer.
main() {
  # Once, before anything prints: the window's QML resolves its language the
  # same way, so the two cannot disagree about what language this is in.
  i18n_load
case ${1:-state} in
  state) shift; state "$@" ;;
  set) shift; set_key "$@" ;;
  reset) shift; setting_reset "${1:-}" ;;
  plugin) shift; plugin_cmd "$@" ;;
  bar) shift; bar_cmd "$@" ;;
  search) search_index ;;
  compose) shift; compose_cmd "$@" ;;
  agents) shift; agents_cmd "$@" ;;
  herdr) shift; herdr_cmd "$@" ;;
  tmux|nvim) app_cmd "$@" ;;
  keys) shift; keys_cmd "$@" ;;
  workspaces) shift; workspaces_cmd "$@" ;;
  devices) shift; devices_cmd "$@" ;;
  display) shift; monitor_cmd "$@" ;;
  theme) shift; themes_cmd "$@" ;;
  language) shift; language_cmd "$@" ;;
  wifi) shift; wifi_cmd "$@" ;;
  bluetooth) shift; bluetooth_cmd "$@" ;;
  power) shift; power_cmd "$@" ;;
  audio) shift; audio_cmd "$@" ;;
  disk) shift; disk_cmd "$@" ;;
  processes) shift; processes_cmd "$@" ;;
  overview) shift; overview_cmd "$@" ;;
  migrate) shift; migrate_cmd "$@" ;;
  packages) shift; packages_cmd "$@" ;;
  security) shift; security_cmd "$@" ;;
  hosts) shift; hosts_cmd "$@" ;;
  apps) shift; apps_cmd "$@" ;;
  usage) shift; usage_cmd "$@" ;;
  news) shift; news_cmd "$@" ;;
  about) shift; about_cmd "$@" ;;
  menu) shift; [[ ${1:-} == run ]] || die "usage: omacontrol menu run <entry-id>"; menu_run "${2:-}" ;;
  *)
    cat >&2 <<'USAGE'
usage:
  omacontrol state
  omacontrol set <key> <value>
  omacontrol reset <key>|--all           (puts a setting back the way it was found)
  omacontrol plugin enable|disable|remove|update <id> | plugin updates
  omacontrol compose list | add "<Multi_key> <a> <b>" "text" | remove "<Multi_key> <a> <b>"
  omacontrol agents list | run <agent-id>
  omacontrol plugin self | plugin self-check     (is this window itself behind?)
  omacontrol plugin poll | plugin site <id>      (what the page reads; the plugin's own repository)
  omacontrol plugin directory | directory-fetch | directory-refresh
                                         (what plugins.omarchy.org says: verified, author, hearts)
  omacontrol search                      (every setting the pages declare, for the search box)
  omacontrol bar move <widget-id> left|center|right | bar shift <widget-id> up|down
                 | bar enable|disable <widget-id>   (in or out of the bar, settings and place kept)
  omacontrol menu run <entry-id>            (runs an Omarchy menu entry's action)
  omacontrol herdr state | set <key> <value>
  omacontrol tmux state | tmux set <option> <value>
  omacontrol nvim state | nvim set <option> <value>
  omacontrol display state | display brightness [<display> <percent>]
  omacontrol devices state | set <device> <option> <value> keyboard|pointer
                 | clear <device> [option] | remove <device>
  omacontrol workspaces state | add <class> | set <class> <field> <value> | remove <class>
                 | setup add <n> | setup set <n> <field> <value> | setup remove <n>
  omacontrol keys list | add "<KEYS>" "<description>" "<command>" | remove "<KEYS>" | disable "<KEYS>"
  omacontrol audio state | audio watch | default output|input <device> | volume output|input <percent>
                 | mute output|input on|off|toggle
  omacontrol power state | power watch | profile ac|battery <power-saver|balanced|performance>
  omacontrol bluetooth state | power on|off | scan | poll | pair|connect|disconnect|forget <address>
  omacontrol theme list | backgrounds | bg <path>
  omacontrol language set <language-code>   (Omarchy's session language; en, fr, da, ...)
  omacontrol wifi list | rescan | poll | link | publicip | speedtest | connect <ssid> [password] | disconnect | forget <ssid>
                 | radio on|off | band auto|2.4|5|6
  omacontrol disk poll | breakdown | mount|unmount <device> | trim | snapshot | open <path>
  omacontrol processes poll | end|kill <pid>... | renice <pid> <nice>
  omacontrol overview poll | switches | watch | toggle nightlight|dnd|awake|dictation | dismiss <id>
  omacontrol packages poll | refresh | fetch | stale | info <name> | update | clean | orphans | pacnew
                 | remove <name> | pick | site <name> | log
  omacontrol security poll              (the firewall's open ports, what is behind them, and how you sign in)
  omacontrol hosts list | edit                (/etc/hosts: what it adds, and the reader's editor to change it)
  omacontrol usage poll | refresh [provider]
  omacontrol news poll | fetch | stale | open <url>
  omacontrol about poll | channel <stable|rc|dev> | copy
USAGE
    exit 1 ;;
esac
}

# Unbuffered, or the watchers say nothing until they exit: GNU head holds what
# it reads in stdio's block buffer, so a line a watcher prints at once — the
# volume moving, a switch flipping — reached the window only when the buffer
# filled or the watcher died. The cap is what head is for; the delay was not.
main "$@" | stdbuf -o0 head -c "$OMACONTROL_READ_MAX"
